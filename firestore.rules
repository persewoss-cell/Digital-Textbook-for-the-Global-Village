rules_version = '2';

// 이 앱은 회원가입/로그인 계정이 없습니다. 대신 누구나 페이지에 들어오면 자동으로
// 조용한 익명 인증이 이루어지고(로그인 화면 없음), 방 비밀번호 확인은 클라이언트에서
// 이뤄집니다(Firebase 무료 요금제라 서버 코드를 쓸 수 없어요). 그래서 아래 규칙은
// "익명이라도 우리 앱을 거쳐 들어왔는지"만 확인하는 가벼운 수준입니다 - 학교 내부에서
// 저장/부담 없이 쓰는 용도에 맞춘 선택입니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    match /rooms/{roomId} {
      allow read, create, delete: if isSignedIn();
      allow update: if false;
    }

    match /participants/{id} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    match /textbooks/{textbookId} {
      allow read, write: if isSignedIn();
    }

    match /studentNotes/{docId} {
      allow read, create, update, delete: if isSignedIn();
    }
    match /studentAnnotations/{docId} {
      allow read, create, update, delete: if isSignedIn();
    }
    match /studentProgress/{docId} {
      allow read, create, update, delete: if isSignedIn();
    }
  }
}
